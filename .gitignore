# ============================================================
# CLEAN-ROOM FIREWALL — copyrighted / derived data
# These MUST NEVER be committed. (legal + clean-room discipline)
# ============================================================

# Original game data (user-provided; ST + DOS, all games)
# (the directory's contents, not the directory, so the layout doc can be kept)
/refdata/*
# keep the layout doc, exclude the data
!/refdata/README.md

# Reference screenshots of the ORIGINAL game (copyrighted art — comparison only, never ship)
/refshots/

# Original or converted game files, whatever the case of the name, wherever they land
*.PAK
*.pak
*.ST
*.MSA
*.PRG
*.TOS
*.SHP
*.PCM
SAVE.[0-9][0-9][0-9]
SAVED.[0-9][0-9][0-9]

# Generated asset packs derived from original data
/build/
/dist/
# if you use a packed extension
*.assetpack
/build/assets/

# Loose extracted/converted media (in case anything lands outside /build)
*.u6pal
extracted/
converted/

# Game save files (may embed copyrighted content; and they're user data)
*.sav
saves/

# ============================================================
# BUILD ARTIFACTS — m68k cross-compile output
# ============================================================
*.o
*.a
*.elf
*.prg
*.tos
*.ttp
*.app
# debug symbol files (unless you commit one on purpose)
*.sym
# linker map (collides w/ game MAP? see note below)
*.map
# assembler listings
*.lst
*.bin
# built disk images
*.img
# ST disk images
*.st
*.msa

# Host-side tool build output (if /tools compiles to native binaries)
/tools/build/
/tools/bin/

# ============================================================
# DEV ENVIRONMENT — emulator, editor, OS noise
# ============================================================
# Hatari runtime state / config that's machine-specific
hatari.cfg
# Hatari audio capture
*.wav
# Hatari video capture
*.avi
*.nvram
# if per-developer; keep a debugger.ini.example instead
debugger.ini

# Editors / IDE
# Keep the SHARED clangd/editor config; ignore per-developer .vscode noise.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*~

# clangd index cache + generated compile database (machine-specific paths)
.cache/
compile_commands.json
# clangd's local cache dir (NOT the .clangd config file)
.clangd/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Claude Code local settings (keep shared, ignore local)
# ============================================================
.claude/settings.local.json


# host Python caches (tools/bot, tools/video)
__pycache__/
